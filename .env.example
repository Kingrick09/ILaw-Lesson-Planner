# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: API Key for OpenRouter.ai to access artificial intelligence services.
# Hides the credentials securely from client-side requests on the server-side.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APPSCRIPT_URL: Google Apps Script Web App Endpoint URL.
# Links user actions directly to your Google Sheet database securely.
APPSCRIPT_URL="MY_APPSCRIPT_URL"

# MESSENGER_LINK: The Facebook Messenger URL or m.me link where educators send upgrade requests.
# e.g., https://m.me/yourpage or https://m.me/yourusername
MESSENGER_LINK="https://m.me/"

# WHATSAPP_NUMBER: (Optional) WhatsApp phone number if also supporting WhatsApp inquiries.
WHATSAPP_NUMBER=09956270884

# PAYMONGO_SECRET_KEY: (Optional/Deprecated in favor of Messenger direct upgrade)
PAYMONGO_SECRET_KEY=

# PAYMONGO_PUBLIC_KEY: (Optional/Deprecated in favor of Messenger direct upgrade)
PAYMONGO_PUBLIC_KEY=

# ADMIN_PASSCODE: Secret master passcode required to access the Payment Verification Dashboard and activate users.
ADMIN_PASSCODE="ilawadmin2025"

